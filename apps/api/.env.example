VENOM_ENV=development
VENOM_HTTP_ADDR=:8080
VENOM_APP_ORIGIN=http://localhost:5173
VENOM_COOKIE_SECURE=false

# SQLite (default)
VENOM_DATABASE_DRIVER=sqlite
VENOM_DATABASE_URL=file:venombusiness.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)

# PostgreSQL example:
# VENOM_DATABASE_DRIVER=postgres
# VENOM_DATABASE_URL=postgres://venom:change-me@localhost:5432/venombusiness?sslmode=disable
